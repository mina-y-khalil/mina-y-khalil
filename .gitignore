# ── OS junk ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*:Zone.Identifier

# ── Editors / IDEs ──
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.history/

# ── Dependencies & build output ──
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/
.cache/
dist/
build/
out/
.next/
.vercel/
coverage/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ── Logs & temp ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
*.tmp
*.bak
*.orig

# ── Secrets: never commit keys, tokens or env files ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
secrets.*
credentials*.json
service-account*.json
.npmrc

# ── Local tooling ──
.claude/settings.local.json
